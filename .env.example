# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Comma-separated origins, or * to allow any.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (MySQL is the source of truth for all delivery state)
# ---------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=webhook
DB_LOGGING=false
# Schema is created by migrations; never enable synchronize against MySQL.
DB_SYNCHRONIZE=false

# ---------------------------------------------------------------------------
# Webhook delivery
# ---------------------------------------------------------------------------
# Point this at any receiver. It defaults to the bundled demo receiver.
WEBHOOK_TARGET_URL=http://localhost:3001/test-receiver/webhook
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_SIGNING_SECRET=dev-secret

# ---------------------------------------------------------------------------
# Retry policy
# ---------------------------------------------------------------------------
MAX_ATTEMPTS=3
# Demo-friendly backoff so retries are watchable: 15s then 30s.
RETRY_DELAY_1_MS=15000
RETRY_DELAY_2_MS=30000
# Production values from the specification:
#   RETRY_DELAY_1_MS=300000     # 5 minutes
#   RETRY_DELAY_2_MS=1800000    # 30 minutes

# ---------------------------------------------------------------------------
# Delivery worker
# ---------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
# A job held in DELIVERING longer than this is treated as a crashed worker.
WORKER_LEASE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Client
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
